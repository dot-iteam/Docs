"","    )",")","","for row in users?.records ?? [] {","    print(row)","}"]},{"level":2,"text":"Close the Connection","type":"heading","anchor":"Close-the-Connection"},{"inlineContent":[{"text":"Call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SQLiteKit\/documentation\/SQLiteKit\/SQLiteDatabase\/close()","type":"reference"},{"text":" when the database is no longer needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["await database.close()"]},{"inlineContent":[{"text":"Closing finalizes all precompiled statements before closing the SQLite connection.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/sqlitekit\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SQLiteKit\/documentation\/SQLiteKit\/GettingStarted","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"SQLiteKit"}],"roleHeading":"Article","role":"article","title":"Getting Started"},"seeAlsoSections":[{"generated":true,"anchor":"Essentials","identifiers":["doc:\/\/SQLiteKit\/documentation\/SQLiteKit\/ExecutingSQL","doc:\/\/SQLiteKit\/documentation\/SQLiteKit\/SchemaManagement","doc:\/\/SQLiteKit\/documentation\/SQLiteKit\/MappingRows"],"title":"Essentials"}],"references":{"doc://SQLiteKit/documentation/SQLiteKit/SchemaManagement":{"type":"topic","title":"Schema Management","role":"article","abstract":[{"text":"Declare SQLite schema objects in Swift and let SQLiteKit create or synchronize them.","type":"text"}],"kind":"article","identifier":"doc:\/\/SQLiteKit\/documentation\/SQLiteKit\/SchemaManagement","url":"\/documentation\/sqlitekit\/schemamanagement"},"doc://SQLiteKit/documentation/SQLiteKit/MappingRows":{"type":"topic","title":"Mapping Rows","role":"article","abstract":[{"type":"text","text":"Map SQLite result rows into explicit Swift values without reflection."}],"kind":"article","identifier":"doc:\/\/SQLiteKit\/documentation\/SQLiteKit\/MappingRows","url":"\/documentation\/