{"abstract":[{"text":"Interpret SwiftHT’s static-output and dynamic-generation performance characteristics.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftHT\/documentation\/SwiftHT\/PerformanceNotes"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","metadata":{"title":"Performance Notes","role":"article","modules":[{"name":"SwiftHT"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/SwiftHT\/documentation\/SwiftHT"]]},"variants":[{"paths":["\/documentation\/swiftht\/performancenotes"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Zero Runtime Overhead for Static Output","anchor":"Zero-Runtime-Overhead-for-Static-Output","type":"heading","level":2},{"inlineContent":[{"text":"SwiftHT’s strongest performance claim applies to pre-rendered static content. When you generate HTML and CSS ahead of time and deploy the generated files, the delivered website has zero SwiftHT runtime overhead. The server only serves static bytes, and the browser does not need a SwiftHT runtime, PHP template execution, React runtime, or hydration work to display the content.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is different from dynamic generation. If an application renders SwiftHT markup on every request, SwiftHT still performs generation work for each request. That path has measurable but modest overhead compared with direct manual writes into a byte buffer."}],"type":"paragraph"},{"text":"Release Benchmark Summary","anchor":"Release-Benchmark-Summary","type":"heading","level":2},{"inlineContent":[{"text":"The package includes benchmark-style Swift Testing checks in ","type":"text"},{"code":"SwiftHTPerformanceTest.swift","type":"codeVoice"},{"text":". The following results were collected from a release-configuration run and compare best sampled timings using ","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Scenario"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Baseline"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Candidate"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Result"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Static generation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Manual buffered writing"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftHT static generation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftHT was 79.28% slower, 1.793x the baseline"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Writer abstraction"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Concrete "},{"type":"codeVoice","code":"BufferedHTWriter"},{"type":"text","text":" writing"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Generic "},{"type":"codeVoice","code":"HTWriter"},{"type":"text","text":" writing"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Generic writing was 15.45% faster, 0.845x the baseline"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Type erasure"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Concrete element rendering"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"AnyHTElement"},{"type":"text","text":" rendering"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type-erased rendering was 22.69% faster, 0.773x the baseline"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Repeated dynamic requests"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Manual dynamic request generation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftHT dynamic request generation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftHT was 84.65% slower, 1.847x the baseline"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Repeated reusable-tree requests"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Manual dynamic request generation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftHT reusable element-tree rendering"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftHT was 59.09% slower, 1.591x the baseline"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Static byte serving"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftHT dynamic request generation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pre-rendered static bytes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Static bytes were effectively 100.00% faster, 0.000x the baseline"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"The repeated request simulation used 1,000 requests. Best sampled per-request timings were:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Approach"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Best per-request time"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manual dynamic generation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"820.256 us"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftHT dynamic generation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"1514.610 us"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftHT reusable element-tree rendering"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"1304.942 us"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pre-rendered static bytes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0.066 us"}]}]]],"type":"table","header":"row","alignments":["unset","right"]},{"anchor":"Interpretation","type":"heading","level":2,"text":"Interpretation"},{"inlineContent":[{"type":"text","text":"The manual buffered baseline is intentionally close to a low-level implementation: reserve one byte buffer and append exact markup directly. SwiftHT adds a typed DSL, result-builder composition, tag objects, attributes, escaping, and reusable components. Being within roughly 1.6x to 1.9x of that manual baseline for dynamic generation is a modest abstraction cost for the safety and maintainability gained."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The writer-abstraction result is also important. Generic "},{"type":"codeVoice","code":"HTWriter"},{"type":"text","text":" rendering stayed in the same range as concrete writer rendering, which suggests the compiler can specialize this path well. In practice, most overhead comes from building and walking the higher-level HTML DSL, not from the writer protocol itself."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For production static sites, the most important result is the static byte serving row. Once SwiftHT output is pre-rendered, request-time generation disappears. That is the basis for the zero-runtime-overhead claim."}],"type":"paragraph"},{"anchor":"Recommended-Wording","type":"heading","level":2,"text":"Recommended Wording"},{"inlineContent":[{"type":"text","text":"Use precise wording based on how the site is deployed:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"For pre-rendered static sites: SwiftHT produces zero-runtime-overhead static HTML and CSS.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For dynamic server-side rendering: SwiftHT has modest generation-time overhead compared with hand-written buffered output."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For reusable server-rendered components: keeping reusable element trees can reduce repeated generation overhead.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Avoid claiming that dynamic SwiftHT rendering has zero overhead. The zero-overhead claim belongs to the deployed static output path."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftHT\/documentation\/SwiftHT\/EscapingAndRawHTML","doc:\/\/SwiftHT\/documentation\/SwiftHT\/RenderingOutput","doc:\/\/SwiftHT\/documentation\/SwiftHT\/BestPractices","doc:\/\/SwiftHT\/documentation\/SwiftHT\/RawHTML","doc:\/\/SwiftHT\/documentation\/SwiftHT\/writeEncodedHtml(_:to:)","doc:\/\/SwiftHT\/documentation\/SwiftHT\/HTWriter","doc:\/\/SwiftHT\/documentation\/SwiftHT\/BufferedHTWriter"],"generated":true,"anchor":"Safety-Output-and-Performance","title":"Safety, Output, and Performance"}],"references":{"doc://SwiftHT/documentation/SwiftHT/BufferedHTWriter":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"BufferedHTWriter"}],"url":"\/documentation\/swiftht\/bufferedhtwriter","navigatorTitle":[{"kind":"identifier","text":"BufferedHTWriter"}],"abstract":[{"type":"text","text":"A byte-buffered writer for UTF-8 HTML output."}],"role":"symbol","identifier":"doc:\/\/SwiftHT\/documentation\/SwiftHT\/BufferedHTWriter","kind":"symbol","title":"BufferedHTWriter","type":"topic"},"doc://SwiftHT/documentation/SwiftHT/HTWriter":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTWriter"}],"url":"\/documentation\/swiftht\/htwriter","navigatorTitle":[{"text":"HTWriter","kind":"identifier"}],"abstract":[{"text":"A destination that receives rendered SwiftHT output.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiftHT\/documentation\/SwiftHT\/HTWriter","type":"topic","title":"HTWriter","kind":"symbol"},"doc://SwiftHT/documentation/SwiftHT":{"role":"collection","title":"SwiftHT","type":"topic","url":"\/documentation\/swiftht","kind":"symbol","identifier":"doc:\/\/SwiftHT\/documentation\/SwiftHT","abstract":[{"type":"text","text":"Build HTML and CSS with a small, strongly typed Swift DSL."}]},"doc://SwiftHT/documentation/SwiftHT/EscapingAndRawHTML":{"abstract":[{"type":"text","text":"Understand how SwiftHT protects text and when to bypass escaping."}],"title":"Escaping and Raw HTML","url":"\/documentation\/swiftht\/escapingandrawhtml","identifier":"doc:\/\/SwiftHT\/documentation\/SwiftHT\/EscapingAndRawHTML","role":"article","type":"topic","kind":"article"},"doc://SwiftHT/documentation/SwiftHT/writeEncodedHtml(_:to:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeEncodedHtml"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"CustomStringConvertible","preciseIdentifier":"s:s23CustomStringConvertibleP"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"HTWriter","preciseIdentifier":"s:7SwiftHT8HTWriterP"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Writes a string-convertible value with HTML escaping applied."}],"title":"writeEncodedHtml(_:to:)","url":"\/documentation\/swiftht\/writeencodedhtml(_:to:)","identifier":"doc:\/\/SwiftHT\/documentation\/SwiftHT\/writeEncodedHtml(_:to:)","role":"symbol","type":"topic","kind":"symbol"},"doc://SwiftHT/documentation/SwiftHT/BestPractices":{"type":"topic","abstract":[{"text":"Use SwiftHT effectively and keep generated markup predictable.","type":"text"}],"identifier":"doc:\/\/SwiftHT\/documentation\/SwiftHT\/BestPractices","role":"article","kind":"article","title":"Best Practices","url":"\/documentation\/swiftht\/bestpractices"},"doc://SwiftHT/documentation/SwiftHT/RenderingOutput":{"abstract":[{"type":"text","text":"Choose the right rendering API for strings, byte data, or custom sinks."}],"title":"Rendering Output","url":"\/documentation\/swiftht\/renderingoutput","identifier":"doc:\/\/SwiftHT\/documentation\/SwiftHT\/RenderingOutput","role":"article","type":"topic","kind":"article"},"doc://SwiftHT/documentation/SwiftHT/RawHTML":{"navigatorTitle":[{"text":"RawHTML","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RawHTML","kind":"identifier"}],"abstract":[{"type":"text","text":"Unescaped HTML markup."}],"title":"RawHTML","identifier":"doc:\/\/SwiftHT\/documentation\/SwiftHT\/RawHTML","url":"\/documentation\/swiftht\/rawhtml","role":"symbol","type":"topic","kind":"symbol"}}}