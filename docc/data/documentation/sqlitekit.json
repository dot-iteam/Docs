{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"SQLiteKit is a SQLite-first toolkit. It does not try to hide SQL behind an object-relational mapper. Instead, it keeps SQL visible while providing Swift conveniences around connection isolation, parameter binding, schema declarations, metadata inspection, and explicit row mapping.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The central type is ","type":"text"},{"identifier":"doc:\/\/SQLiteKit\/documentation\/SQLiteKit\/SQLiteDatabase","type":"reference","isActive":true},{"text":". It opens a SQLite database, configures common pragmas, serializes access through Swift actor isolation, executes SQL, manages reusable prepared statements, and synchronizes schema entities.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use SQLiteKit when you want:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Direct control over SQL.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Prepared statements with Swift value binding.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A lightweight schema DSL for tables, constraints, indexes, views, and triggers.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Explicit row mapping without reflection.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Database metadata inspection.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Time-derived SQLite-friendly identifiers with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SQLiteKit\/documentation\/SQLiteKit\/Scul"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Basic-Example","type":"heading","text":"Basic Example"}